# OPNsense API (System > Access > Users > API keys)
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_KEY=
OPNSENSE_SECRET=
# true = accept the self-signed OPNsense certificate (default). Better: set OPNSENSE_CA to the CA file.
OPNSENSE_INSECURE=true
# OPNSENSE_CA=/certs/opnsense-ca.pem

# Interface keys as OPNsense calls them (wan, opt1, ...). Comma separated for multi-WAN.
WAN_INTERFACES=wan
# Optional: extra local networks (CIDR, comma separated). LAN prefixes are detected automatically.
# LOCAL_NETS=192.168.0.0/16,fd00::/8

# ASN / network lookup via the free iptoasn.com database (downloaded once a week, ~10 MB)
ASN_LOOKUP=true

# Dashboard language: de or en
LANGUAGE=de

PORT=8080
TZ=Europe/Berlin
# DEMO=1 runs with generated data, no OPNsense needed
